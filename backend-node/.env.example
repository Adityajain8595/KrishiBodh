# Backend environment variables
# Copy to .env and fill in values. Never commit .env to git.
# For production (e.g. Render), set these in the hosting dashboard instead.

NODE_ENV=development
PORT=3000

# Frontend URL for CORS (production only). No trailing slash.
# Example: https://krishibodh.onrender.com
CORS_ORIGIN=

# Google Gemini (required for assistant/explanation)
GEMINI_API_KEY=

# Firebase Admin SDK – paste the entire service account JSON as a single line.
# In production (Render), paste the minified JSON in the Environment tab.
FIREBASE_SERVICE_ACCOUNT=

# Optional: Speech-to-Text (e.g. Groq)
GROQ_API_KEY=

# Optional: Text-to-Speech (Google Cloud TTS)
# Either set an API key or path to service account JSON.
GOOGLE_CLOUD_TTS_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=./key.json

# Optional: Market prices (data.gov.in)
DATA_GOV_IN_API_KEY=
